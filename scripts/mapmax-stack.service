# MapMax stack — systemd USER service (installed on the VM as the `mapmax` user).
#
# Why: `podman-compose up -d` from a CI job / SSH / oneshot leaves the rootless
# port-forwarder (`rootlessport`) in the CALLER's cgroup, so it's killed when the
# caller exits → post-deploy 502s (#90). Running the stack as this long-lived
# service makes systemd own the forwarder, so it survives deploys, and
# Restart=always is the auto-heal (no separate watchdog needed).
#
# Install (as mapmax, with linger enabled):
#   cp scripts/mapmax-stack.service ~/.config/systemd/user/
#   # set XDG_RUNTIME_DIR below to /run/user/$(id -u) for this user
#   systemctl --user daemon-reload && systemctl --user enable --now mapmax-stack.service
# Deploys just: systemctl --user restart mapmax-stack.service (see deploy-confinia.sh).
[Unit]
Description=MapMax podman-compose stack (edge+web+web-staging+web-sandbox)
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/projects/mapmax
# 1PESI band (platform PR #10): 14000 is the home port; the compose file
# dual-publishes legacy 8087 until the platform decommissions it.
Environment=WEB_PORT=14000
Environment=XDG_RUNTIME_DIR=/run/user/1002
ExecStartPre=-/usr/bin/podman-compose down
ExecStart=/usr/bin/podman-compose up edge web web-staging web-sandbox
ExecStop=/usr/bin/podman-compose down
Restart=always
RestartSec=5
TimeoutStopSec=40

[Install]
WantedBy=default.target
