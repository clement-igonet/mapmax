# MapMax stack — systemd USER service (installed on the VM as the `mapmax` user).
#
# Why: `podman-compose up -d` from a CI job / SSH / oneshot leaves the rootless
# port-forwarder (`rootlessport`) in the CALLER's cgroup, so it's killed when the
# caller exits → post-deploy 502s (#90). Running the stack as this long-lived
# service makes systemd own the forwarder, so it survives deploys, and
# Restart=always is the auto-heal (no separate watchdog needed).
#
# Install (as mapmax, with linger enabled):
#   cp scripts/mapmax-stack.service ~/.config/systemd/user/
#   cp scripts/mapmax-sandbox-stack.service ~/.config/systemd/user/   # (#146)
#   # set XDG_RUNTIME_DIR below to /run/user/$(id -u) for this user
#   systemctl --user daemon-reload && systemctl --user enable --now mapmax-stack.service
# Deploys just: systemctl --user restart mapmax-stack.service (see deploy-confinia.sh).
[Unit]
Description=MapMax production stack (edge + web + web-staging)
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/projects/mapmax
# 1PESI band, environment fixed by the E digit: PROD 14000, STAGING 14300,
# SANDBOX 14400. These are pinned HERE as well as in the compose defaults
# because this unit's environment overrides the compose file — during the
# 14xxx migration that is exactly how 14000 silently failed to bind.
Environment=WEB_PORT=14000
Environment=STAGING_PORT=14300
Environment=SANDBOX_PORT=14400
Environment=XDG_RUNTIME_DIR=/run/user/1002
# NEVER `down` (#146): it tears down the whole compose project, sandbox
# included — which is how a branch validation used to bounce production and a
# production deploy used to clobber the branch under test. Own only these
# services; --force-recreate replaces them without needing a project-wide rm.
ExecStart=/usr/bin/podman-compose up --force-recreate edge web web-staging
ExecStop=/usr/bin/podman-compose stop edge web web-staging
Restart=always
RestartSec=5
TimeoutStopSec=40

[Install]
WantedBy=default.target
