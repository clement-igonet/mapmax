# MapMax edge — the single entry point the platform reverse-proxies to.
#
# The (owner-managed) platform Caddyfile terminates TLS for
# www/sandbox/staging.mapmax.confinia.io and forwards everything to
# 127.0.0.1:8087 — which is THIS server (the `edge` service in
# docker-compose.yml publishes it). Host-based routing happens here, inside
# mapmax's own stack, so environments can be split without touching the
# platform config:
#
#   www.mapmax.confinia.io      → web          (production, public)
#   sandbox.mapmax.confinia.io  → web-sandbox  (ISOLATED, access-gated — the
#                                 playground for paid/advanced features; will be
#                                 entitlement-gated via polar.sh, basic-auth in
#                                 the meantime)
#   staging.mapmax.confinia.io  → web          (point at a web-staging later)
#   anything else (dev/e2e)     → web
{
	auto_https off
}

:80 {
	@www host www.mapmax.confinia.io mapmax.confinia.io
	handle @www {
		reverse_proxy web:80
	}

	@sandbox host sandbox.mapmax.confinia.io
	handle @sandbox {
		# Access is gated in the app by a Polar license key (#76): the sandbox
		# build shows a paste-your-key screen validated against Polar's public
		# customer-portal API. (Soft, feature-demo gate — a static site can't
		# hard-gate front-end-only; add forward_auth here if a hard gate is
		# needed later.)
		reverse_proxy web-sandbox:80
	}

	@staging host staging.mapmax.confinia.io
	handle @staging {
		reverse_proxy web:80
	}

	# Default (localhost:8087 during dev, container-network access).
	handle {
		reverse_proxy web:80
	}
}
