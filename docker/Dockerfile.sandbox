# MapMax SANDBOX image — the production static site PLUS sandbox-only extras,
# served at sandbox.mapmax.confinia.io so www (the base image) stays pristine.
# Differences from ../Dockerfile: the `COPY tools/` line, and the MapLibre
# override below. Keep the shared COPY lines in sync with ../Dockerfile.
FROM docker.io/library/nginx:1.27-alpine

COPY index.html styles.css SPECIFICATIONS.md /usr/share/nginx/html/
COPY src/ /usr/share/nginx/html/src/
COPY assets/ /usr/share/nginx/html/assets/
COPY vendor/ /usr/share/nginx/html/vendor/
COPY tools/ /usr/share/nginx/html/tools/
# The sandbox runs the position-only-LOD MapLibre build (maplibre#8057 fork
# branch, built by scripts/vendor-maplibre.sh into vendor/maplibre-8057) — over-
# write the stock vendored bundle so the app loads #8057 at the same importmap
# path. www (the base image) keeps the released 6.1.0 bundle. See mapmax#94.
COPY vendor/maplibre-8057/maplibre-gl.mjs vendor/maplibre-8057/maplibre-gl-shared.mjs vendor/maplibre-8057/maplibre-gl-worker.mjs vendor/maplibre-8057/maplibre-gl.css /usr/share/nginx/html/vendor/maplibre/
COPY docker/default.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
